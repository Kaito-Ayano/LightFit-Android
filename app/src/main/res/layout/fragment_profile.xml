<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/lf_lang_title" android:textSize="18sp" android:textStyle="bold" />

        <RadioGroup android:id="@+id/lang_group"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton android:id="@+id/lang_zh" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="中文" />
            <RadioButton android:id="@+id/lang_en" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="English" />
            <RadioButton android:id="@+id/lang_ru" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Русский" />
            <RadioButton android:id="@+id/lang_kk" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Қазақша" />
            <RadioButton android:id="@+id/lang_ko" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="한국어" />
        </RadioGroup>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/auth_privacy" android:textSize="12sp" />

        <Button android:id="@+id/btn_reset" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="@string/lf_reset_data" />

        <TextView android:id="@+id/tv_version"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
