<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/mood_title" android:textSize="18sp" android:textStyle="bold" />

        <RadioGroup android:id="@+id/mood_group"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton android:id="@+id/mood_5" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/mood_happy" />
            <RadioButton android:id="@+id/mood_4" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/mood_neutral" />
            <RadioButton android:id="@+id/mood_3" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/mood_tired" />
            <RadioButton android:id="@+id/mood_2" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/mood_anxious" />
            <RadioButton android:id="@+id/mood_1" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/mood_sore" />
        </RadioGroup>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/lf_body_title"
            android:textSize="18sp" android:textStyle="bold" />

        <RadioGroup android:id="@+id/body_group"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/body_1" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/lf_body_1" />
            <RadioButton android:id="@+id/body_2" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:text="@string/lf_body_2" />
            <RadioButton android:id="@+id/body_3" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:text="@string/lf_body_3" />
        </RadioGroup>

        <Button android:id="@+id/btn_generate" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="@string/lf_generate" />

        <TextView android:id="@+id/plan_result_title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textSize="16sp" android:textStyle="bold" />

        <LinearLayout android:id="@+id/plan_list"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="8dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/checkin_note" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
